# PostgreSQL Configuration
POSTGRES_DB=products_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PRODUCTS=products.events

# OpenTelemetry Configuration
OTLP_ENDPOINT=http://localhost:4317

# ClickHouse Configuration
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=observability
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Application Ports
PRODUCT_API_PORT=8000
PRODUCT_CONSUMER_PORT=8081

# Log Level
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development

# Chaos Engineering (disabled by default)
ENABLE_CHAOS=false
ERROR_RATE=0.1
LATENCY_MS_MIN=100
LATENCY_MS_MAX=2000

# Consumer Chaos Engineering
CHAOS_ERROR_RATE=0.1
CHAOS_LATENCY_MIN_MS=100
CHAOS_LATENCY_MAX_MS=2000
